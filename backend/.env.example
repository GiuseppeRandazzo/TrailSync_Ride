# Django Settings
SECRET_KEY=django-insecure-outdoora-core-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# CORS Settings for Mobile and Web
CORS_ALLOW_ALL_ORIGINS=True

# OpenAI Configuration
# Set MOCK_OPENAI=True to generate rich contextual cultural tour guide scripts without OpenAI API quota/key.
# Set MOCK_OPENAI=False and provide OPENAI_API_KEY to use live GPT model.
MOCK_OPENAI=True
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

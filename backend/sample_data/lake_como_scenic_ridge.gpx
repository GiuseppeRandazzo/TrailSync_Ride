<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Outdoora Ride Platform" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Lake Como Scenic Ridge: Bellagio to Madonna del Ghisallo</name>
    <desc>Scenic cycling tour starting from Bellagio lake promenade climbing up to the iconic cyclists' sanctuary of Madonna del Ghisallo.</desc>
    <time>2026-05-15T08:30:00Z</time>
  </metadata>

  <!-- Waypoints / POIs -->
  <wpt lat="45.9880" lon="9.2625">
    <ele>215</ele>
    <name>Piazza Mazzini &amp; Bellagio Lakefront</name>
    <desc>Start point near the ferry terminal. Bike partner hub and briefing area.</desc>
  </wpt>
  <wpt lat="45.9810" lon="9.2590">
    <ele>240</ele>
    <name>Villa Melzi Gardens Viewpoint</name>
    <desc>Historic 19th-century botanical garden along the lakeshore with neoclassical statues.</desc>
  </wpt>
  <wpt lat="45.9520" lon="9.2550">
    <ele>480</ele>
    <name>Belvedere di Civenna</name>
    <desc>Panoramic balcony overlooking the Grigna mountain group and the eastern branch of Lake Como.</desc>
  </wpt>
  <wpt lat="45.9240" lon="9.2670">
    <ele>754</ele>
    <name>Madonna del Ghisallo Cyclist Sanctuary</name>
    <desc>The world-famous patron shrine of cycling, hosting legendary bicycles, pink jerseys and cycling museum.</desc>
  </wpt>
  <wpt lat="45.9080" lon="9.2780">
    <ele>820</ele>
    <name>Rifugio &amp; Panoramic Terrace</name>
    <desc>Final scenic stop with traditional Alpine refreshments and 360-degree views of the Prealps.</desc>
  </wpt>

  <!-- Track points -->
  <trk>
    <name>Bellagio to Ghisallo Ridge Track</name>
    <type>Cycling</type>
    <trkseg>
      <!-- Segment 1: Bellagio Port climb start -->
